# --- CoinGecko API -----------------------------------------------------------
# Optional. Leave blank to use the public API (subject to stricter rate limits
# and, on the free plan, ~365 days of historical data).
# A CoinGecko "Demo" key is sent as the `x-cg-demo-api-key` header.
COINGECKO_API_KEY=

# Base URL. Use the pro endpoint if you have a paid plan.
#   Public/Demo: https://api.coingecko.com/api/v3
#   Pro:         https://pro-api.coingecko.com/api/v3
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3

# Header used to send the API key. Demo keys -> x-cg-demo-api-key,
# Pro keys -> x-cg-pro-api-key.
COINGECKO_API_KEY_HEADER=x-cg-demo-api-key

# HTTP tuning
COINGECKO_TIMEOUT_SECONDS=30
COINGECKO_MAX_RETRIES=3
COINGECKO_BACKOFF_SECONDS=1.5

# --- Local file storage ------------------------------------------------------
DATA_DIR=data

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crypto
POSTGRES_USER=crypto_user
POSTGRES_PASSWORD=change_me

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
